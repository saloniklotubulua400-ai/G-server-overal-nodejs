const crypto = require("crypto");

// Temporary in-memory orders
const orders = [];

// ==========================================
// CREATE ORDER
// ==========================================

const createOrder = (req, res) => {
    const {
        productId,
        category,
        phoneNumber,
        amount,
        currency = "KES"
    } = req.body;

    // Basic validation
    if (!productId || !category || !phoneNumber || !amount) {
        return res.status(400).json({
            success: false,
            message: "productId, category, phoneNumber and amount are required"
        });
    }

    if (Number(amount) <= 0) {
        return res.status(400).json({
            success: false,
            message: "Amount must be greater than zero"
        });
    }

    // Generate unique order ID
    const orderId = `ELS-${crypto.randomUUID()}`;

    const order = {
        id: orderId,
        productId,
        category,
        phoneNumber,
        amount: Number(amount),
        currency,
        status: "pending",
        paymentStatus: "unpaid",
        providerStatus: "pending",
        createdAt: new Date().toISOString()
    };

    orders.push(order);

    res.status(201).json({
        success: true,
        message: "Order created successfully",
        data: order
    });
};

// ==========================================
// GET ALL ORDERS
// ==========================================

const getOrders = (req, res) => {
    res.status(200).json({
        success: true,
        count: orders.length,
        data: orders
    });
};

// ==========================================
// GET ORDER BY ID
// ==========================================

const getOrderById = (req, res) => {
    const { id } = req.params;

    const order = orders.find(item => item.id === id);

    if (!order) {
        return res.status(404).json({
            success: false,
            message: "Order not found"
        });
    }

    res.status(200).json({
        success: true,
        data: order
    });
};

// ==========================================
// CANCEL ORDER
// ==========================================

const cancelOrder = (req, res) => {
    const { id } = req.params;

    const order = orders.find(item => item.id === id);

    if (!order) {
        return res.status(404).json({
            success: false,
            message: "Order not found"
        });
    }

    if (order.status !== "pending") {
        return res.status(400).json({
            success: false,
            message: "Only pending orders can be cancelled"
        });
    }

    order.status = "cancelled";
    order.updatedAt = new Date().toISOString();

    res.status(200).json({
        success: true,
        message: "Order cancelled successfully",
        data: order
    });
};

module.exports = {
    createOrder,
    getOrders,
    getOrderById,
    cancelOrder
};